#!/usr/bin/env python3
"""wifi-lab-priv — privilege helper for WiFi Lab GUI.

Runs as root (via sudo). Actions:
  check              verify helper + sudo
  scan IFACE         iw scan dump (WPS/security info)
  run TOOL [ARGS]    run an allowed tool as root
  monitor-run IFACE CHANNEL|- TOOL [ARGS]   monitor mode + tool
  handshake IFACE CHANNEL BSSID OUTPREFIX [TIMEOUT]
  restore IFACE      back to managed mode
  install PACKAGE    apt-get install -y
"""
import os
import re
import shutil
import signal
import subprocess
import sys
import time

VERSION = "1.0"

ALLOWED_TOOLS = {
    "airmon-ng", "airodump-ng", "aireplay-ng", "aircrack-ng",
    "reaver", "wash", "bully", "mdk4", "iw", "nmcli", "ip",
    "iwconfig", "rfkill",
}
MONITOR_TOOLS = {"airodump-ng", "aireplay-ng", "reaver", "wash", "bully", "mdk4"}
PACKAGES = {
    "airmon-ng": "aircrack-ng", "airodump-ng": "aircrack-ng",
    "aireplay-ng": "aircrack-ng", "aircrack-ng": "aircrack-ng",
    "reaver": "reaver", "wash": "reaver", "bully": "bully",
    "mdk4": "mdk4", "iw": "iw",
}
IFACE_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,32}$")
CHANNEL_RE = re.compile(r"^[0-9]{1,4}$")
HEX_MAC_RE = re.compile(r"^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$")


def out(msg=""):
    print(msg, flush=True)


def err(msg):
    print(msg, file=sys.stderr, flush=True)


def check_root():
    if os.geteuid() != 0:
        err("ERROR: wifi-lab-priv must run as root")
        sys.exit(2)


def run_sync(cmd, timeout=60):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return None


def stream_run(cmd):
    """Run command and stream its stdout/stderr lines to our stdout."""
    proc = subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
    )
    for line in proc.stdout:
        print(line, end="", flush=True)
    return proc.wait()


def iface_exists(iface):
    return bool(iface) and os.path.exists(f"/sys/class/net/{iface}")


def enter_monitor(iface, channel=None):
    """Put iface into monitor mode; return monitor iface name or None."""
    if not iface_exists(iface):
        err(f"ERROR: interface {iface} not found")
        return None
    # Stop NetworkManager interference so airmon can take the interface.
    run_sync(["nmcli", "radio", "wifi", "off"], timeout=30)
    time.sleep(1)
    r = run_sync(["airmon-ng", "start", iface, channel or "0"], timeout=60)
    if r is None or r.returncode != 0:
        err(f"ERROR: airmon-ng start failed: {(r.stderr if r else 'timeout').strip()}")
        return None
    mon = iface + "mon"
    if not iface_exists(mon):
        mon = iface  # driver did not rename
    if channel:
        run_sync(["iw", "dev", mon, "set", "channel", str(channel)], timeout=30)
    out(f"[priv] monitor mode active on {mon} (channel {channel or 'any'})")
    return mon


def restore_managed(iface):
    mon = iface + "mon"
    target = mon if iface_exists(mon) else iface
    run_sync(["airmon-ng", "stop", target], timeout=60)
    run_sync(["nmcli", "radio", "wifi", "on"], timeout=30)
    time.sleep(1)
    run_sync(["nmcli", "device", "connect", iface], timeout=30)


# --------------------------------------------------------------------------
# Actions
# --------------------------------------------------------------------------

def action_check():
    out(f"OK wifi-lab-priv {VERSION}")


def action_scan(iface):
    if not iface_exists(iface):
        err("ERROR: interface not found")
        return 3
    run_sync(["ip", "link", "set", iface, "up"], timeout=30)
    r = run_sync(["iw", "dev", iface, "scan", "dump", "-b"], timeout=30)
    if r is None or r.returncode != 0 or "BSS " not in (r.stdout or ""):
        r = run_sync(["iw", "dev", iface, "scan", "-b"], timeout=60)
    if r is None or r.returncode != 0:
        err("ERROR: iw scan failed")
        return 3
    out(r.stdout.rstrip("\n"))
    return 0


def action_run(tool, args):
    if tool not in ALLOWED_TOOLS:
        err(f"ERROR: tool {tool} not allowed")
        return 3
    path = shutil.which(tool)
    if not path:
        err(f"ERROR: {tool} not installed (package: {PACKAGES.get(tool, tool)})")
        return 3
    return stream_run([path] + args)


def action_monitor_run(iface, channel, tool, args):
    if tool not in MONITOR_TOOLS:
        err(f"ERROR: {tool} is not a monitor-mode tool")
        return 3
    path = shutil.which(tool)
    if not path:
        err(f"ERROR: {tool} not installed (package: {PACKAGES.get(tool, tool)})")
        return 3
    mon = enter_monitor(iface, None if channel == "-" else channel)
    if not mon:
        return 3
    mapped = [mon if a == iface else a for a in args]
    try:
        return stream_run([path] + mapped)
    finally:
        restore_managed(iface)


def action_handshake(iface, channel, bssid, outprefix, timeout):
    if not CHANNEL_RE.fullmatch(channel or ""):
        err("ERROR: invalid channel")
        return 3
    if not HEX_MAC_RE.fullmatch(bssid or ""):
        err("ERROR: invalid BSSID")
        return 3
    mon = enter_monitor(iface, channel)
    if not mon:
        return 3
    band = "a" if int(channel) > 14 else "bg"
    os.makedirs(os.path.dirname(outprefix) or ".", exist_ok=True)
    airodump = subprocess.Popen(
        ["airodump-ng", mon, "--bssid", bssid, "--channel", channel,
         "--band", band, "--write", outprefix, "--write-interval", "1",
         "--output-format", "pcap"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )
    aireplay = subprocess.Popen(
        ["aireplay-ng", mon, "--deauth", "0", "-a", bssid],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    deadline = time.time() + max(10, int(timeout or 120))
    found = False
    try:
        while time.time() < deadline:
            line = airodump.stdout.readline()
            if not line:
                if airodump.poll() is not None:
                    break
                time.sleep(0.2)
                continue
            line = line.rstrip()
            if line:
                out(line)
            if "WPA handshake" in line and bssid.upper() in line.upper():
                found = True
                break
    finally:
        aireplay.terminate()
        time.sleep(1)
        airodump.terminate()
        airodump.wait()
        aireplay.wait()
        restore_managed(iface)
    if found:
        out("HANDSHAKE_FOUND")
        return 0
    err("TIMEOUT: no handshake captured")
    return 1


def action_install(package):
    r = run_sync(["apt-get", "update"], timeout=300)
    if r is None or r.returncode != 0:
        err("ERROR: apt-get update failed")
        return 3
    r = run_sync(["apt-get", "install", "-y", package], timeout=600)
    if r is None or r.returncode != 0:
        err("ERROR: install failed")
        return 3
    out(f"INSTALLED {package}")
    return 0


def main():
    if len(sys.argv) < 2:
        err("usage: wifi-lab-priv <action> [args...]")
        return 2
    action = sys.argv[1]
    args = sys.argv[2:]
    check_root()
    if action == "check":
        return action_check()
    if action == "scan" and len(args) >= 1:
        return action_scan(args[0])
    if action == "run" and len(args) >= 1:
        return action_run(args[0], args[1:])
    if action == "monitor-run" and len(args) >= 3:
        return action_monitor_run(args[0], args[1], args[2], args[3:])
    if action == "handshake" and len(args) >= 4:
        return action_handshake(args[0], args[1], args[2], args[3],
                                args[4] if len(args) > 4 else "120")
    if action == "install" and len(args) >= 1:
        return action_install(args[0])
    if action == "restore" and len(args) >= 1:
        restore_managed(args[0])
        out("OK restored")
        return 0
    err("ERROR: bad action or arguments")
    return 2


if __name__ == "__main__":
    sys.exit(main())
